# Rust / Tauri build output. The root .gitignore has a stale `app/shell/target/`
# rule that predates this package's real path; this covers the actual location.
src-tauri/target/

# Generated icon binaries (see src-tauri/icons/README.md — regenerate with `tauri icon`).
src-tauri/icons/*.png
src-tauri/icons/*.ico
src-tauri/icons/*.icns
# tauri icon also emits platform icon subdirs (Android/iOS) — regenerated, not source.
src-tauri/icons/android/
src-tauri/icons/ios/

# Placeholder icon source used to smoke-test the bundle pipeline; supply real art instead.
icon-source.png

# `tauri build`/`tauri android|ios init` generated scaffolding + ACL schemas.
src-tauri/gen/

# Updater signing private key must never be committed.
*.key
