{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Midnight Tavern",
  "version": "0.2.7",
  "identifier": "com.midnighttavern.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace @midnight-tavern/ui",
    "beforeBuildCommand": "npm run build --workspace @midnight-tavern/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Midnight Tavern",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "createUpdaterArtifacts": false,
    "publisher": "Midnight Tavern",
    "category": "Entertainment",
    "shortDescription": "Local-first roleplay with deterministic mechanics and evolving memory.",
    "longDescription": "Midnight Tavern is a local-first roleplay application with gated, deterministic game mechanics and persistent, evolving memory. All story data lives on the user's machine.",
    "copyright": "Copyright (c) 2026 Midnight Tavern",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.example.com/midnight-tavern/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "PLACEHOLDER_REPLACE_WITH_OUTPUT_OF_tauri_signer_generate",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
