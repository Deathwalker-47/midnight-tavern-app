{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Least-privilege permissions for the main Midnight Tavern window: local SQLite, local logs, auto-update checks, file-import dialogs, diagnostics folder reveal, and scoped filesystem access limited to the app data directory. No arbitrary FS, no shell, no HTTP allowlist beyond the updater.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "log:default",
    "opener:allow-reveal-item-in-dir",

    "updater:default",

    "sql:default",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "path": "$APPDATA/midnight-tavern.db" }]
    },

    "dialog:allow-open",

    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    }
  ]
}
